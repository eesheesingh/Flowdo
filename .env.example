NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Comma-separated host allow-list (host[:port], no protocol) used by
# /auth/confirm to validate the incoming Host/X-Forwarded-Host header before
# using it to build the post-verification redirect URL. Prevents Host-header
# injection if the app is ever placed behind a reverse proxy/CDN that
# doesn't strip client-supplied X-Forwarded-Host. Add your production
# domain(s) alongside the local defaults when deploying.
ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
